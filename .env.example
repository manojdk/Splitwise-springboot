# Copy to .env and fill in real values. .env is git-ignored.

# PostgreSQL (docker compose uses these for both the database container and the app)
DB_NAME=splitwise
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Only needed when running the app outside docker compose
DB_URL=jdbc:postgresql://localhost:5432/splitwise

# HS256 signing key, at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-bytes

# Optional: access-token lifetime as ISO-8601 duration (default PT1H)
JWT_EXPIRATION=PT1H
